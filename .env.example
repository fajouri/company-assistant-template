POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Optional: loopback host port for the local test database (default 5432). Override if 5432 is already taken.
# POSTGRES_HOST_PORT=5432
# Fictional placeholders let the anonymous shell start. Replace all three for real Entra sign-in.
ENTRA_TENANT_ID=11111111-1111-1111-1111-111111111111
ENTRA_CLIENT_ID=33333333-3333-3333-3333-333333333333
ENTRA_CLIENT_SECRET=replace-with-your-local-entra-client-secret
# Optional, only needed to index and search real content (Foundry/Azure-OpenAI-compatible embeddings).
# EMBEDDINGS__ENDPOINT=https://your-resource.openai.azure.com
# EMBEDDINGS__API_KEY=replace-with-your-local-embedding-key
# EMBEDDINGS__DEPLOYMENT=text-embedding-3-small
