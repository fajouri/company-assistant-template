<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <!-- Pin the patched transitive release; 10.0.10 has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Pgvector" Version="0.3.2" />
    <!-- Semantic Kernel core abstractions (ChatHistory, IChatCompletionService, streaming
         contents). The chat transport is implemented directly against the configurable
         Foundry/Azure-OpenAI-compatible endpoint so no beta Azure.AI.OpenAI dependency is
         pulled in; see FoundryChatCompletionService. -->
    <PackageReference Include="Microsoft.SemanticKernel.Core" Version="1.81.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Knowledge\Migrations\*.sql"
                      LogicalName="Knowledge.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CompanyAssistant.Web.Tests" />
  </ItemGroup>
</Project>
